# BNB Smart Chain testnet (chainId 97). Ganti ke RPC lain kalau public RPC lambat.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
POOL_ADDRESS=
# block saat pool di-deploy (biar keeper nggak scan dari block 0)
START_BLOCK=0
# akun yang bayar gas submitReport + claimBatch (tidak punya hak khusus di kontrak)
RELAYER_KEY=
# DEMO SAJA: semua key attester di satu mesin. Produksi: tiap attester server sendiri.
ATTESTER_KEYS=
POLL_SECONDS=120
MIN_MAG=4.0
# pool demo: masa sanggah (detik) sebelum klaim dibuka, dan jeda antar replay di dashboard
CHALLENGE_SECONDS=180
REPLAY_COOLDOWN_SECONDS=300
# opsional: Etherscan API v2 key (etherscan.io/myapikey) untuk `npm run verify` via API
BSCSCAN_API_KEY=
